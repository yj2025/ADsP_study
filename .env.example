# Local development: messages are written to data/mail-outbox/.
MAIL_MODE=local
# Public support address shown on the privacy and account deletion pages.
# SUPPORT_EMAIL=support@example.com

# For external HTTPS service, replace MAIL_MODE and configure a mail webhook.
# MAIL_MODE=webhook
# APP_ORIGIN=https://study.example.com
# COOKIE_SECURE=1
# MAIL_WEBHOOK_URL=https://mail.example.com/send
# MAIL_WEBHOOK_TOKEN=replace-with-your-token
